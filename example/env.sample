# RichFlyer SDK 検証アプリの設定サンプル
#
# このファイルを .env にコピーして値を書き換えてください。
#   cp env.sample .env
#
# .env は .gitignore 済みのためコミットされません。
# 認証情報をコミットしないよう、必ず .env 側に記述してください。

# --- 認証情報（RichFlyer管理サイトのサービス管理画面から取得） ---
# カスタマーID
CUSTOMER_ID=aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa
# サービスID
SERVICE_ID=bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb
# 管理API実行キー
API_KEY=cccccccc-cccc-cccc-cccc-cccccccccccc
# SDK実行キー
SDK_KEY=dddddddd-dddd-dddd-dddd-dddddddddddd

# --- 投稿系APIのデフォルト値 ---
# テンプレートID（管理サイトの投稿管理画面から取得）
TEMPLATE_ID=eeeeeeee-eeee-eeee-eeee-eeeeeeeeeeee
